{
  "name": "dsh-ollama",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin for Ollama native protocol",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.7-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "~1.8.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-brand": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.7-rc.2"
  }
}
